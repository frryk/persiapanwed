// ====================================================
// FIRESTORE SECURITY RULES — Deploy di Firebase Console
// ====================================================
// Firebase Console → Firestore → Rules → Paste rules ini → Publish
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Super admin helper
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'frryk404@gmail.com';
    }

    // Allow superadmin to query all users (root docs)
    match /users/{userId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == userId;
    }

    // Allow superadmin to query all profiles via collectionGroup
    match /{path=**}/profile/{docId} {
      allow read: if isSuperAdmin();
    }

    // User profile — only owner can write, anyone auth can read (for partner lookup)
    match /users/{userId}/profile/main {
      allow write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      allow read: if request.auth != null || isSuperAdmin();
    }

    // Wedding data — owner OR linked partner can read/write
    match /users/{userId}/weddingData/{docId} {
      // Owner access
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Partner access (via linkedTo field in their profile)
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/main)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/main).data.linkedTo == userId;
    }

    // Invite codes — any auth user can read, only owner can create/delete their own
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
